# PostgreSQL & Prisma
DATABASE_URL="postgresql://reachinbox:reachinbox@localhost:5432/reachinbox?schema=public"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379

# SMTP (Ethereal or Production SMTP)
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_USER="your-ethereal-user@ethereal.email"
SMTP_PASS="your-ethereal-password"
SMTP_FROM="your-ethereal-user@ethereal.email"

# Worker Settings
WORKER_CONCURRENCY=5
PORT=5000

# Slack Notifications (Optional - Alert triggered when hourly rate limit is reached)
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:5000/api/auth/google/callback"
FRONTEND_URL="http://localhost:5173"

# Elasticsearch (Optional - will fallback to PostgreSQL search if not configured)
ELASTICSEARCH_NODE="http://localhost:9200"
ELASTICSEARCH_API_KEY=""
